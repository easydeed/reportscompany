# TrendyReports environment template.
# Copy to .env and fill in. Placeholders only — never commit real values.
# Every variable listed here is read by code; call sites verified 2026-08-17
# (remediation ticket T0.2). Variables read only by dev/QA scripts are in the
# last section.

# ============================================================
# Web — apps/web (Vercel)
# ============================================================
NEXT_PUBLIC_API_BASE=http://localhost:10000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key-here
# Optional: override the property-report asset host (default: https://assets.trendyreports.com)
NEXT_PUBLIC_ASSETS_URL=
# Optional: set to "1" to cloak /admin routes as 404 (middleware.ts)
ADMIN_CLOAK_404=
# Server-to-server token for /print and /social render routes; must match the API's value
INTERNAL_RENDER_TOKEN=

# Read by two proxy routes only (nonstandard — see FINDINGS.md):
# app/api/proxy/v1/affiliate/accounts/[accountId]/unsponsor/route.ts, app/api/proxy/v1/property/preview/route.ts
NEXT_PUBLIC_API_URL=
API_URL=

# ============================================================
# API — apps/api (Render web service)
# Fields on Settings (settings.py) are read from env by pydantic.
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_reports
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-me-in-prod
ENVIRONMENT=development
# JSON list, e.g. ["http://localhost:3000"]
ALLOWED_ORIGINS=
APP_BASE=https://www.trendyreports.io
APP_URL=https://trendyreports.io

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
STRIPE_PRICE_PRO_MONTH=price_xxx
STRIPE_PRICE_TEAM_MONTH=price_xxx

# Email (SendGrid is the live provider)
SENDGRID_API_KEY=your-sendgrid-key-here
EMAIL_FROM_ADDRESS=TrendyReports <noreply@trendyreports.io>
EMAIL_REPLY_TO=support@trendyreports.io
DEFAULT_FROM_EMAIL=reports@trendyreports.io
DEFAULT_FROM_NAME=TrendyReports

# SiteX Pro (property/assessor data) — OAuth2 client credentials
SITEX_BASE_URL=https://api.uat.bkitest.com
SITEX_CLIENT_ID=your-sitex-client-id-here
SITEX_CLIENT_SECRET=your-sitex-client-secret-here
SITEX_FEED_ID=your-sitex-feed-id-here

# SimplyRETS (MLS data) — HTTP basic auth
SIMPLYRETS_USERNAME=your-simplyrets-username-here
SIMPLYRETS_PASSWORD=your-simplyrets-password-here

# Cloudflare R2 (S3-compatible storage: PDFs, logos, QR codes, photo proxy)
R2_ACCOUNT_ID=your-r2-account-id-here
R2_ACCESS_KEY_ID=your-r2-access-key-here
R2_SECRET_ACCESS_KEY=your-r2-secret-key-here
R2_BUCKET_NAME=market-reports
R2_PUBLIC_URL=
R2_PRESIGN_EXPIRES_S=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-token-here
TWILIO_PHONE_NUMBER=

# ============================================================
# Worker — apps/worker (Render background worker)
# Also needs: DATABASE_URL, REDIS_URL, SENDGRID_API_KEY, DEFAULT_FROM_*,
# SIMPLYRETS_*, R2_*, TWILIO_* from above.
# ============================================================
CELERY_RESULT_URL=redis://localhost:6379/1
# HMAC secret for unsubscribe links (worker refuses silently-broken links without it)
EMAIL_UNSUB_SECRET=replace-me-in-prod
# Base URL used to build unsubscribe links in emails
WEB_BASE=http://localhost:3000
# Still read by failure-notification and consumer-report paths (tasks.py:668,1894) — see FINDINGS.md
RESEND_API_KEY=

# PDF rendering: PDF_ENGINE selects the engine ("playwright" default, or "pdfshift")
PDF_ENGINE=playwright
PDFSHIFT_API_KEY=your-pdfshift-key-here
PDFSHIFT_API_URL=
# Generic PDF API used by pdf_adapter.py (PDFShift-compatible)
PDF_API_URL=
PDF_API_KEY=
# Base URL for the legacy /print/{runId} render path
PRINT_BASE=https://trendyreports.io

# AI insights (GPT-backed commentary; falls back to templates when disabled)
AI_INSIGHTS_ENABLED=false
OPENAI_API_KEY=your-openai-key-here

# MLS photo proxy (rehost listing photos on R2 for PDF reliability)
PHOTO_PROXY_ENABLED=true
PHOTO_PROXY_FETCH_TIMEOUT_S=
PHOTO_PROXY_MAX_RETRIES=
PHOTO_PROXY_RETRY_DELAY_S=

# Property report assets + aerial imagery
ASSETS_BASE_URL=
GOOGLE_MAPS_API_KEY=your-google-maps-server-key-here

# Schedule tick / keep-alive
API_BASE_URL=https://reportscompany.onrender.com
TICK_INTERVAL=60
KEEP_ALIVE_INTERVAL=300
FRONTEND_URL=https://www.trendyreports.io
MR_REPORT_ENQUEUE_KEY=

# SimplyRETS vendor tuning (defaults are sane; override only if needed)
SIMPLYRETS_BASE_URL=
SIMPLYRETS_VENDOR=
SIMPLYRETS_TIMEOUT_S=
SIMPLYRETS_RPM=
SIMPLYRETS_BURST=
SIMPLYRETS_MAX_RESULTS=
SIMPLYRETS_ALLOW_SORT=

# ============================================================
# Dev/QA scripts only (never needed in deployed environments)
# ============================================================
QA_API_BASE=
QA_TOKEN=
QA_ACCOUNT_ID=
MR_TOKEN=
TEST_AUTH_TOKEN=
PDF_DIR=
SOCIAL_DIR=
PDF_REVIEW_OUT=
PREVIEW_SCREENSHOTS_DIR=
