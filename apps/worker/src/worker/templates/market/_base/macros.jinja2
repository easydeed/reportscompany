{# ── Median trend chart (§7.3) ─────────────────────────────────────────────
   Twelve monthly medians as one line. Inline SVG: this is rendered by
   PDFShift, so there is no script, no external request and no web font
   dependency inside the mark — everything the chart needs is in the document
   already.

   THE SPECS ARE NOT PREFERENCES. 2px line with round joins; end marker r>=4
   with a 2px surface ring; hairline SOLID gridlines one step off the surface
   (never dashed — dashing reads as "projection" when it is just a grid); area
   wash at 10%; labels on the endpoint and the extreme ONLY, never a number on
   every point.

   TEXT WEARS TEXT TOKENS, NOT THE SERIES COLOUR. The line carries identity;
   the value labels and axis ticks are grays. A brand hue light enough to be a
   cheerful line is illegible as 9px text.

   NO LEGEND. One series, so the heading above already names it; a box with one
   swatch restates the heading and costs page space, which on this surface is
   the scarcest thing there is.

   NO HOVER LAYER, and that is the one place this departs from how the same
   chart would be built for a screen. There is no pointer in a PDF. Nothing is
   gated behind one either: the axis ticks carry the scale, the two direct
   labels carry the values that matter, and `months_note` states the sample.

   A GAP IS A GAP. `value: none` means that month had fewer than three
   closings, so there is no median to draw. The path breaks rather than
   dropping to zero, because a zero would draw a crash that did not happen.
#}
{% macro median_trend_chart(points, ink, months_note=none, width=680, height=150) %}
{%- set pad_l = 52 -%}
{%- set pad_r = 74 -%}
{%- set pad_t = 12 -%}
{%- set pad_b = 20 -%}
{%- set plot_w = width - pad_l - pad_r -%}
{%- set plot_h = height - pad_t - pad_b -%}
{%- set drawn = points | selectattr('value') | list -%}
{%- if drawn | length >= 2 -%}
{%- set vals = drawn | map(attribute='value') | list -%}
{%- set vmin = vals | min -%}
{%- set vmax = vals | max -%}
{%- set span = (vmax - vmin) if (vmax - vmin) > 0 else (vmax * 0.1 or 1) -%}
{# A flat series would otherwise divide by zero and a 3% pad keeps the line off
   the gridlines at the extremes. #}
{%- set lo = vmin - span * 0.15 -%}
{%- set hi = vmax + span * 0.15 -%}
{%- set n = points | length -%}
{%- set step = plot_w / (n - 1) if n > 1 else plot_w -%}
<div class="trend-chart avoid-break">
  <svg viewBox="0 0 {{ width }} {{ height }}" width="100%" height="{{ height }}"
       role="img" aria-label="Median closed price by month, last {{ n }} months"
       style="display:block; overflow:visible;">
    {% for f in [0.0, 0.5, 1.0] %}
    {%- set y = pad_t + plot_h * f -%}
    {%- set v = hi - (hi - lo) * f -%}
    <line x1="{{ pad_l }}" y1="{{ '%.1f' % y }}" x2="{{ pad_l + plot_w }}" y2="{{ '%.1f' % y }}"
          stroke="#e7e5e4" stroke-width="1" />
    <text x="{{ pad_l - 8 }}" y="{{ '%.1f' % (y + 3) }}" text-anchor="end"
          font-size="9" fill="#78716c"
          style="font-variant-numeric: tabular-nums;">{{ v | format_currency_short }}</text>
    {% endfor %}

    {%- set ns = namespace(d='', started=false) -%}
    {%- for p in points -%}
      {%- set x = pad_l + step * loop.index0 -%}
      {%- if p.value -%}
        {%- set y = pad_t + plot_h * (hi - p.value) / (hi - lo) -%}
        {%- set ns.d = ns.d ~ (' M' if not ns.started else ' L') ~ ('%.1f' % x) ~ ' ' ~ ('%.1f' % y) -%}
        {%- set ns.started = true -%}
      {%- else -%}
        {%- set ns.started = false -%}
      {%- endif -%}
    {%- endfor -%}
    <path d="{{ ns.d | trim }}" fill="none" stroke="{{ ink }}" stroke-width="2"
          stroke-linejoin="round" stroke-linecap="round" />

    {% for p in points %}
    {%- set x = pad_l + step * loop.index0 -%}
    <text x="{{ '%.1f' % x }}" y="{{ height - 6 }}" text-anchor="middle"
          font-size="9" fill="#78716c">{{ p.label }}</text>
    {% endfor %}

    {# Endpoint and extreme only. The endpoint is where the reader's eye lands;
       the extreme is the other number they will look for. Everything else is
       the axis's job. #}
    {%- set last = drawn | last -%}
    {%- set top = (drawn | sort(attribute='value') | last) -%}
    {% for p in points %}
      {%- if p.value and (p is sameas last or (p is sameas top and top.value != last.value)) -%}
      {%- set x = pad_l + step * loop.index0 -%}
      {%- set y = pad_t + plot_h * (hi - p.value) / (hi - lo) -%}
      <circle cx="{{ '%.1f' % x }}" cy="{{ '%.1f' % y }}" r="4.5"
              fill="{{ ink }}" stroke="#ffffff" stroke-width="2" />
      {%- if p is sameas last -%}
      <text x="{{ '%.1f' % (x + 10) }}" y="{{ '%.1f' % (y + 4) }}" text-anchor="start"
            font-size="11" font-weight="600" fill="#292524"
            >{{ p.value | format_currency_short }}</text>
      {%- else -%}
      <text x="{{ '%.1f' % x }}" y="{{ '%.1f' % (y - 10) }}" text-anchor="middle"
            font-size="10" font-weight="600" fill="#44403c"
            >{{ p.value | format_currency_short }}</text>
      {%- endif -%}
      {%- endif -%}
    {% endfor %}
  </svg>
  {% if months_note %}
  <p class="trend-chart-note">{{ months_note }}</p>
  {% endif %}
</div>
{%- endif -%}
{% endmacro %}


{# ── Page-1 masthead (§7.1 variant A) ──────────────────────────────────────
   The full gradient masthead, as ORDINARY BODY CONTENT on page 1.

   It used to live in PDFShift's `header` slot and repeat at full size on every
   page. It cannot stay there and also be page-1-only: that needs
   header.start_at=2 with footer.start_at=1, and PDFShift silently coerces both
   to 2, taking the page-1 footer with it (D-103, measured). Moving it into the
   body sidesteps the negotiation entirely — the document flows, so this appears
   once, at the top, which is what "page 1 only" means in a flowing document.

   It also stops being a height negotiated with a vendor. In the header slot the
   reservation and the paint had to be kept in agreement by hand, and they were
   not: 1.3in reserved for 1.165in painted. Here it is as tall as its content.
#}
{% macro report_masthead(header, agent) %}
<div class="masthead avoid-break">
  <div class="masthead-left">
    <h1 class="masthead-title">{{ header.title }}{% if header.city %} <span class="masthead-city">— {{ header.city }}</span>{% endif %}</h1>
    <p class="masthead-subtitle">
      Last <span class="masthead-highlight">{{ header.lookback_days }} days</span>
      {%- if header.subtitle %} · {{ header.subtitle }}{% endif %} · Live MLS Data
    </p>
    {% if header.total_count %}
    <div class="masthead-metric">
      <span class="masthead-metric-value">{{ header.total_count }}</span>
      <span class="masthead-metric-label">{{ header.title }}</span>
    </div>
    {% endif %}
  </div>
  <div class="masthead-right">
    {% if agent and agent.logo_url %}
    <img class="masthead-logo" src="{{ agent.logo_url }}" alt="">
    {% endif %}
  </div>
</div>
{% endmacro %}
