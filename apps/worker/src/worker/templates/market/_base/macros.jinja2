{# =============================================================================
   MARKET REPORT MACROS — V0 Final Design System
   Reusable components for all 4 market report layouts.

   PDF-COMPREHENSIVE — every layout that renders a listings collection now:
     • Wraps it in a .gallery-section with the brand-colored section heading
     • Renders the "Showing X of Y …" truncation subtitle from the builder
     • Renders the "+ N more listings, contact me…" callout when more exist
     • Iterates the *full* `listings` array (the cap is owned by the builder)
   ============================================================================= #}


{# Tiny helper: section header + subtitle, used at the top of every
   listings collection. Keeps the visual language consistent across
   gallery / market_narrative / closed_inventory / analytics / pricebands. #}
{% macro listings_section_header(label, subtitle) %}
  {% if label %}
    <h2 class="gallery-heading">{{ label }}</h2>
  {% endif %}
  {% if subtitle %}
    <p class="gallery-subtitle">{{ subtitle }}</p>
  {% endif %}
{% endmacro %}


{# "+ N more listings. Contact me…" callout. Renders only when a more_note
   was supplied by the builder (i.e. total > cap AND PDF_CONFIG declares
   a more_template for this report type). #}
{% macro more_listings_callout(more_note) %}
  {% if more_note %}
    <div class="more-listings-note avoid-break">
      <p>{{ more_note }}</p>
    </div>
  {% endif %}
{% endmacro %}


{# ── Gallery Layout (A): new_listings_gallery, featured_listings, open_houses #}
{# ── Nothing matched ───────────────────────────────────────────────────────
   D-108. A report whose search returned nothing still renders and still says
   so, IN THE TERMS OF THE SEARCH. "No listings found for this period" leaves
   the reader unable to tell an empty market from a filter that excluded
   everything, and those have opposite responses. Echoing city, window and
   filters makes the difference readable on the page.

   This does NOT decide whether such a report should be SENT. That is a
   scheduling question, filed as D-110, not answered here. #}
{% macro no_results_notice(header) %}
<div class="empty-state" style="text-align:center;padding:1.25in 0;">
  <p style="font-size:13px;font-weight:600;color:#44403c;margin:0 0 6px;">
    No listings matched this search.
  </p>
  <p class="subtle" style="font-size:11px;color:#78716c;margin:0;">
    {{ header.title }}{% if header.city %} in {{ header.city }}{% endif %} &middot;
    last {{ header.lookback_days }} days{% if header.subtitle %} &middot; {{ header.subtitle }}{% endif %}
  </p>
</div>
{% endmacro %}


{% macro gallery_layout(header, listings, stats, report_type, agent, ai_narrative=none,
                        listings_section_label=none, listings_truncation_note=none,
                        listings_more_note=none) %}
{# count-bar removed: redundant with the big gradient hero header that
   shows report title + count + subtitle on every page #}

{% if ai_narrative %}
<div class="ai-narrative avoid-break">
  <div class="ai-narrative-label">AI Market Insight</div>
  <p class="ai-narrative-text">{{ ai_narrative }}</p>
</div>
{% endif %}

{% if listings %}
<div class="gallery-section">
  {{ listings_section_header(listings_section_label, listings_truncation_note) }}
  <div class="gallery-grid">
    {% for listing in listings %}
    <div class="listing-card avoid-break">
      <div class="listing-photo{% if not listing.photo_url %} no-image{% endif %}"{% if listing.photo_url %} style="background-image: url('{{ listing.photo_url }}');"{% endif %}>
        {% if report_type == 'featured_listings' %}
        <span class="listing-status featured">Featured</span>
        {% elif report_type == 'open_houses' %}
        <span class="listing-status">{% if listing.next_open_house %}Open {{ listing.next_open_house[:10] }}{% else %}Open House{% endif %}</span>
        {% elif report_type == 'new_listings_gallery' %}
        <span class="listing-status">New</span>
        {% endif %}
      </div>
      <div class="listing-info">
        <div class="listing-price">{% if listing.list_price %}{{ listing.list_price | format_currency }}{% else %}&mdash;{% endif %}</div>
        <div class="listing-address">{{ listing.address | default('Address unavailable') | truncate(40) }}</div>
        <div class="listing-details">
          {% if listing.beds is not none %}<span class="listing-detail">{% if listing.beds %}<strong>{{ listing.beds }}</strong> bd{% else %}<strong>Studio</strong>{% endif %}</span>{% endif %}
          {% if listing.baths %}<span class="listing-detail"><strong>{{ listing.baths }}</strong> ba</span>{% endif %}
          {% if listing.sqft %}<span class="listing-detail"><strong>{{ listing.sqft | format_number }}</strong> sf</span>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {{ more_listings_callout(listings_more_note) }}
</div>
{% else %}
{% if report_type == 'open_houses' %}
<div class="empty-state">
  <p>No upcoming open houses found in this area for the next 7 days.</p>
  <p class="subtle">Open house data is updated weekly from MLS.</p>
</div>
{% else %}
<div class="gallery-grid">
  <div style="grid-column:1/-1;">{{ no_results_notice(header) }}</div>
</div>
{% endif %}
{% endif %}
{% endmacro %}


{# ── Market Narrative Layout (B): market_snapshot ───────────────────────────── #}
{% macro market_narrative_layout(header, listings, stats, report_type, agent, ai_insights=none, ai_narrative=none,
                                 listings_section_label=none, listings_truncation_note=none,
                                 listings_more_note=none, monthly_trend=none, monthly_trend_note=none,
                                 monthly_trend_fmt='currency', primary_ink=none) %}
<div class="hero-stat avoid-break">
  <div class="hero-stat-value">{% if stats.median_close_price %}{{ stats.median_close_price | format_currency }}{% elif stats.median_list_price %}{{ stats.median_list_price | format_currency }}{% else %}&mdash;{% endif %}</div>
  <div class="hero-stat-label">Median Sale Price</div>
</div>

{% if ai_narrative or ai_insights %}
<div class="ai-narrative avoid-break">
  <div class="ai-narrative-label">AI Market Insight</div>
  <p class="ai-narrative-text">{{ ai_narrative or ai_insights }}</p>
</div>
{% endif %}

<div class="stats-bar avoid-break">
  {% if stats.avg_dom is not none %}
  <div class="stats-bar-row">
    <span class="stats-bar-label">Avg Days on Market</span>
    <span class="stats-bar-value">{{ stats.avg_dom }}</span>
  </div>
  {% endif %}
  {% if stats.months_of_inventory is not none %}
  <div class="stats-bar-row">
    <span class="stats-bar-label">Months of Inventory{% if stats.months_of_inventory_pace %} <span class="stats-note">({{ stats.months_of_inventory_pace }})</span>{% endif %}</span>
    <span class="stats-bar-value">{{ stats.months_of_inventory }}</span>
  </div>
  {% endif %}
  {% if stats.price_per_sqft %}
  <div class="stats-bar-row">
    <span class="stats-bar-label">Price per Sq Ft</span>
    <span class="stats-bar-value">${{ stats.price_per_sqft | format_number }}</span>
  </div>
  {% endif %}
  {% if stats.list_to_sale_pct %}
  <div class="stats-bar-row">
    <span class="stats-bar-label">List-to-Sale Ratio</span>
    <span class="stats-bar-value">{{ "%.1f" | format(stats.list_to_sale_pct) }}%</span>
  </div>
  {% endif %}
</div>

{% if monthly_trend %}
{# §7.3 / D-102 — the trend chart CLOSES page 1, and the listings start on page
   2 below it.

   Jerry's call, 2026-09-28, and the measurement that framed it: page 1 holds
   either a row of three listings or this chart, never both. Both give a
   two-page report carrying the same nine listings, so the choice is what page 1
   LEADS WITH rather than what the report contains. The chart won because it is
   the only thing on that page a reader cannot get from Zillow or their own
   saved search — a twelve-month median for their market, from MLS closings —
   and because these reports go on a schedule to an agent's past clients, who
   want to know what their own house is doing rather than what is for sale.

   RECORDED AGAINST IT: listings are photographs and photographs draw the eye
   where a line chart does not. If the primary reader ever becomes an active
   buyer, revisit this rather than inherit it.

   Marks in primary_ink, never raw primary — primary_ink is the only brand value
   themes.py guarantees as ink on a light surface, and this page's surface is
   white, so the guarantee holds here exactly rather than approximately. Not
   true of every surface in this product; see D-100. #}
{{ monthly_trend_chart(monthly_trend, primary_ink or '#1f2937', monthly_trend_note, monthly_trend_fmt) }}
{% endif %}

{% if listings %}
{# `force-new-page` ONLY when the chart is on page 1. Without the chart there is
   nothing to give the page up for, and an unconditional break would leave 2.8in
   of white space above a page break. Two deterministic states, both pinned in
   PAGE_1_CAPACITY — not a third variable.

   The heading and the truncation note are INSIDE this div, so they travel with
   the listings rather than stranding at the foot of page 1 above nothing. #}
<div class="gallery-section{% if monthly_trend %} force-new-page{% endif %}">
  {{ listings_section_header(listings_section_label, listings_truncation_note) }}
  <div class="gallery-grid">
    {% for listing in listings %}
    <div class="listing-card avoid-break">
      <div class="listing-photo{% if not listing.photo_url %} no-image{% endif %}"{% if listing.photo_url %} style="background-image: url('{{ listing.photo_url }}');"{% endif %}>
        {% if listing.status %}
        <span class="listing-status">{{ listing.status }}</span>
        {% endif %}
      </div>
      <div class="listing-info">
        <div class="listing-price">{% if listing.list_price %}{{ listing.list_price | format_currency }}{% else %}&mdash;{% endif %}</div>
        <div class="listing-address">{{ listing.address | default('Address unavailable') | truncate(40) }}</div>
        <div class="listing-details">
          {% if listing.beds is not none %}<span class="listing-detail">{% if listing.beds %}<strong>{{ listing.beds }}</strong> bd{% else %}<strong>Studio</strong>{% endif %}</span>{% endif %}
          {% if listing.baths %}<span class="listing-detail"><strong>{{ listing.baths }}</strong> ba</span>{% endif %}
          {% if listing.sqft %}<span class="listing-detail"><strong>{{ listing.sqft | format_number }}</strong> sf</span>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {{ more_listings_callout(listings_more_note) }}
</div>
{% endif %}

{% endmacro %}


{# ── Closed / Inventory Layout (C): closed, inventory ─────────────────────── #}
{% macro closed_inventory_layout(header, listings, stats, report_type, agent, ai_insights=none, ai_narrative=none,
                                 listings_section_label=none, listings_truncation_note=none,
                                 listings_more_note=none, monthly_trend=none, monthly_trend_note=none,
                                 monthly_trend_fmt='currency', primary_ink=none) %}
{% if monthly_trend %}
{{ monthly_trend_chart(monthly_trend, primary_ink or '#1f2937', monthly_trend_note, monthly_trend_fmt) }}
{% endif %}
<div class="hero-stat-row avoid-break">
  <div class="hero-stat-left">
    {% if report_type == 'closed' %}
    <div class="hero-stat-value">{% if stats.median_close_price %}{{ stats.median_close_price | format_currency }}{% elif stats.median_list_price %}{{ stats.median_list_price | format_currency }}{% else %}{{ stats.closed_count | default(0) }}{% endif %}</div>
    <div class="hero-stat-label">{% if stats.median_close_price or stats.median_list_price %}Median Sale Price{% else %}Homes Sold{% endif %}</div>
    {% else %}
    <div class="hero-stat-value">{{ stats.active_count | default(0) }}</div>
    <div class="hero-stat-label">Active Listings</div>
    {% endif %}
  </div>
  <div class="hero-stat-right">
    {% if stats.avg_dom is not none %}
    <div class="mini-stat">
      <div class="mini-stat-value">{{ stats.avg_dom }}</div>
      <div class="mini-stat-label">Avg DOM</div>
    </div>
    {% endif %}
    {% if stats.months_of_inventory is not none %}
    <div class="mini-stat">
      <div class="mini-stat-value">{{ stats.months_of_inventory }}</div>
      <div class="mini-stat-label">Mo. Supply{% if stats.months_of_inventory_pace %}<br><span class="stats-note">{{ stats.months_of_inventory_pace }}</span>{% endif %}</div>
    </div>
    {% endif %}
    {% if stats.price_per_sqft %}
    <div class="mini-stat">
      <div class="mini-stat-value">${{ stats.price_per_sqft | format_number }}</div>
      <div class="mini-stat-label">$/Sq Ft</div>
    </div>
    {% endif %}
    {% if stats.list_to_sale_pct %}
    <div class="mini-stat">
      <div class="mini-stat-value">{{ "%.1f" | format(stats.list_to_sale_pct) }}%</div>
      <div class="mini-stat-label">Sale Ratio</div>
    </div>
    {% endif %}
  </div>
</div>

{% if ai_narrative or ai_insights %}
<div class="ai-narrative avoid-break">
  <div class="ai-narrative-label">AI Market Insight</div>
  <p class="ai-narrative-text">{{ ai_narrative or ai_insights }}</p>
</div>
{% endif %}

{% if listings %}
<div class="gallery-section">
  {{ listings_section_header(listings_section_label, listings_truncation_note) }}
  <table class="data-table">
    <thead>
      <tr>
        <th>Address</th>
        <th>Bd/Ba</th>
        <th>Sq Ft</th>
        <th>Price</th>
        <th>DOM</th>
      </tr>
    </thead>
    <tbody>
      {% for l in listings %}
      <tr>
        <td class="td-address">{{ l.address | default('-') | truncate(28) }}</td>
        <td class="td-muted">{% if l.beds is none %}-{% elif l.beds %}{{ l.beds }}{% else %}Studio{% endif %}/{{ l.baths if l.baths is not none else '-' }}</td>
        <td class="td-muted">{% if l.sqft %}{{ l.sqft | format_number }}{% else %}-{% endif %}</td>
        <td class="td-price">{% if report_type == 'closed' and l.close_price %}{{ l.close_price | format_currency }}{% elif l.list_price %}{{ l.list_price | format_currency }}{% else %}-{% endif %}</td>
        <td class="td-muted">{% if l.days_on_market is none %}-{% elif l.days_on_market %}{{ l.days_on_market }}{% else %}New{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {{ more_listings_callout(listings_more_note) }}
</div>
{% endif %}
{% endmacro %}


{# ── Analytics Layout (D): new_listings ──────────────────────────────────── #}
{% macro analytics_layout(header, listings, stats, price_bands, report_type, agent, ai_insights=none, ai_narrative=none,
                          listings_section_label=none, listings_truncation_note=none,
                          listings_more_note=none) %}
<div class="hero-stat avoid-break">
  {% if report_type == 'price_bands' %}
  <div class="hero-stat-value">{{ header.total_count | default(0) }}</div>
  <div class="hero-stat-label">Active Listings</div>
  {% else %}
  <div class="hero-stat-value">{{ header.total_count | default(0) }}</div>
  <div class="hero-stat-label">New This Month</div>
  {% endif %}
</div>

<div class="stat-blocks avoid-break">
  {% if price_bands %}
  {% for band in price_bands[:4] %}
  <div class="stat-block{% if loop.first %} stat-block-accent{% endif %}">
    <div class="stat-block-value">{{ band.count | default(0) }}</div>
    <div class="stat-block-label">{{ band.label | default('') }}</div>
  </div>
  {% endfor %}
  {% else %}
  {% if stats.median_close_price or stats.median_list_price %}
  <div class="stat-block">
    <div class="stat-block-value">{{ (stats.median_close_price or stats.median_list_price) | format_currency_short }}</div>
    <div class="stat-block-label">Median Price</div>
  </div>
  {% endif %}
  {% if stats.avg_dom is not none %}
  <div class="stat-block">
    <div class="stat-block-value">{{ stats.avg_dom }}</div>
    <div class="stat-block-label">Avg DOM</div>
  </div>
  {% endif %}
  {% if stats.price_per_sqft %}
  <div class="stat-block">
    <div class="stat-block-value">${{ stats.price_per_sqft | format_number }}</div>
    <div class="stat-block-label">Price / Sq Ft</div>
  </div>
  {% endif %}
  {% if stats.months_of_inventory is not none %}
  <div class="stat-block">
    <div class="stat-block-value">{{ stats.months_of_inventory }}</div>
    <div class="stat-block-label">Months Supply{% if stats.months_of_inventory_pace %}<br><span class="stats-note">{{ stats.months_of_inventory_pace }}</span>{% endif %}</div>
  </div>
  {% endif %}
  {% endif %}
</div>

{% if ai_narrative or ai_insights %}
<div class="ai-narrative avoid-break">
  <div class="ai-narrative-label">AI Market Insight</div>
  <p class="ai-narrative-text">{{ ai_narrative or ai_insights }}</p>
</div>
{% endif %}

{% if listings %}
<div class="gallery-section">
  {{ listings_section_header(listings_section_label, listings_truncation_note) }}
  <div class="property-list">
    {% set tier_labels = ['Low', 'Median', 'High'] %}
    {% set tier_classes = ['tier-low', 'tier-median', 'tier-high'] %}
    {% for listing in listings %}
    <div class="property-card avoid-break">
      <div class="property-card-photo{% if not listing.photo_url %} no-image{% endif %}"{% if listing.photo_url %} style="background-image: url('{{ listing.photo_url }}');"{% endif %}>
        {% if report_type != 'new_listings' and listing.status %}
        <span class="property-card-badge">{{ listing.status }}</span>
        {% endif %}
      </div>
      <div class="property-card-info">
        {% if report_type == 'new_listings' and loop.index0 < 3 %}
        <span class="listing-tier-badge {{ tier_classes[loop.index0] }}" style="position:absolute;top:10px;right:10px;">{{ tier_labels[loop.index0] }}</span>
        {% endif %}
        <div class="property-card-price">{% if listing.list_price %}{{ listing.list_price | format_currency }}{% else %}&mdash;{% endif %}</div>
        <div class="property-card-address">{{ listing.address | default('Address unavailable') | truncate(40) }}{% if listing.city %}, {{ listing.city }}{% endif %}</div>
        <div class="property-card-details">
          {% if listing.beds is not none %}<span class="property-card-detail">{% if listing.beds %}<strong>{{ listing.beds }}</strong> beds{% else %}<strong>Studio</strong>{% endif %}</span>{% endif %}
          {% if listing.baths %}<span class="property-card-detail"><strong>{{ listing.baths }}</strong> baths</span>{% endif %}
          {% if listing.sqft %}<span class="property-card-detail"><strong>{{ listing.sqft | format_number }}</strong> sqft</span>{% endif %}
          {% if listing.days_on_market is not none %}<span class="property-card-detail">{% if listing.days_on_market %}<strong>{{ listing.days_on_market }}</strong> DOM{% else %}<strong>New</strong>{% endif %}</span>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {{ more_listings_callout(listings_more_note) }}
</div>
{% else %}
<div class="property-list">
  {{ no_results_notice(header) }}
</div>
{% endif %}
{% endmacro %}


{# ── Price Bands Layout: price_bands ──────────────────────────────────────── #}
{% macro pricebands_layout(header, listings, stats, price_bands, report_type, agent, ai_insights=none, ai_narrative=none,
                           listings_section_label=none, listings_truncation_note=none,
                           listings_more_note=none, band_chart_note=none, primary_ink=none) %}
<div class="top-row">
  <div class="hero-card">
    <div class="hero-card-value">{{ header.total_count | default(0) }}</div>
    <div class="hero-card-label">Total Active Listings</div>
  </div>
  <div class="stat-cards">
    {% if price_bands %}
    {# EVERY band, not the first four (D-107). The [:4] dated to the squashed
       base commit with no recorded intent, and measured it was protecting
       nothing: six cards fit at 56px each with labels on three lines, nothing
       clipped, costing 10.4px of row height. It was an aesthetic preference
       paid for in hidden information — a report that drops "nothing above
       $1.6M" from an agent showing it to a client. #}
    {% for band in price_bands %}
    <div class="stat-card">
      <div class="stat-card-value">{{ band.count | default(0) }}</div>
      <div class="stat-card-label">{{ band.label | default('') }}</div>
    </div>
    {% endfor %}
    {% else %}
    {% if stats.median_close_price or stats.median_list_price %}
    <div class="stat-card">
      <div class="stat-card-value">{{ (stats.median_close_price or stats.median_list_price) | format_currency_short }}</div>
      <div class="stat-card-label">Median Price</div>
    </div>
    {% endif %}
    {% if stats.avg_dom is not none %}
    <div class="stat-card">
      <div class="stat-card-value">{{ stats.avg_dom }}</div>
      <div class="stat-card-label">Avg DOM</div>
    </div>
    {% endif %}
    {% if stats.price_per_sqft %}
    <div class="stat-card">
      <div class="stat-card-value">${{ stats.price_per_sqft | format_number }}</div>
      <div class="stat-card-label">Price / Sq Ft</div>
    </div>
    {% endif %}
    {% if stats.months_of_inventory is not none %}
    <div class="stat-card">
      <div class="stat-card-value">{{ stats.months_of_inventory }}</div>
      <div class="stat-card-label">Months Supply{% if stats.months_of_inventory_pace %}<br><span class="stats-note">{{ stats.months_of_inventory_pace }}</span>{% endif %}</div>
    </div>
    {% endif %}
    {% endif %}
  </div>
</div>

{% if price_bands %}
{{ band_distribution_chart(price_bands, primary_ink or '#1f2937', band_chart_note) }}
{% endif %}

{# HERO-RESTORE — Use the canonical .ai-narrative block (matching
   market_narrative_layout) for visual consistency. The old .pb-narrative
   class with its orange callout box + 10px body text drifted from the
   rest of the report; we now share the plain-white-card + uppercase
   "AI MARKET INSIGHT" label + 14px body across all layouts. The
   .pb-narrative CSS in base.jinja2 is now orphan; safe to delete in a
   future cleanup. #}
{% if ai_narrative or ai_insights %}
<div class="ai-narrative avoid-break">
  <div class="ai-narrative-label">AI Market Insight</div>
  <p class="ai-narrative-text">{{ ai_narrative or ai_insights }}</p>
</div>
{% endif %}

{% if listings %}
<div class="gallery-section">
  {{ listings_section_header(listings_section_label, listings_truncation_note) }}
  <div class="property-rows">
    {% for listing in listings %}
    <div class="property-row">
      <div class="property-photo{% if not listing.photo_url %} no-image{% endif %}">
        {% if listing.photo_url %}
        <img src="{{ listing.photo_url }}" alt="Property">
        {% endif %}
      </div>
      <div class="property-info">
        <div class="property-address">{{ listing.address | default('Address unavailable') | truncate(35) }}</div>
        <div class="property-city">{% if listing.city %}{{ listing.city }}{% endif %}</div>
      </div>
      <div class="property-details">
        <div class="property-price">{% if listing.list_price %}{{ listing.list_price | format_currency }}{% else %}&mdash;{% endif %}</div>
        <div class="property-specs">{% if listing.beds is not none %}{% if listing.beds %}{{ listing.beds }} bd{% else %}Studio{% endif %}{% endif %}{% if listing.baths %} &bull; {{ listing.baths }} ba{% endif %}{% if listing.sqft %} &bull; {{ listing.sqft | format_number }} sqft{% endif %}</div>
      </div>
      <div class="property-status">
        {% if listing.status %}
        <span class="status-badge {{ listing.status | lower }}">{{ listing.status }}</span>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {{ more_listings_callout(listings_more_note) }}
</div>
{% else %}
<div class="property-rows">
  {{ no_results_notice(header) }}
</div>
{% endif %}

{% endmacro %}


{# ── Agent Footer ─────────────────────────────────────────────────────────── #}
{% macro agent_footer(agent) %}
<div class="agent-footer">
  <div class="agent-info">
    {% if agent and agent.photo_url %}
    <img class="agent-photo" src="{{ agent.photo_url }}" alt="Agent Photo">
    {% else %}
    <div class="agent-photo-placeholder">{% if agent and agent.name %}{{ agent.name[0] | upper }}{% endif %}</div>
    {% endif %}
    <div>
      <div class="agent-name">{{ agent.name | default('') if agent else '' }}</div>
      {% if agent and agent.title %}<div class="agent-title">{{ agent.title }}</div>{% endif %}
      {% if agent and (agent.phone or agent.email) %}
      <div class="agent-contact">
        {% if agent.phone %}<span class="agent-contact-pill">{{ agent.phone }}</span>{% endif %}
        {% if agent.email %}<span class="agent-contact-pill">{{ agent.email }}</span>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
  {% if agent and agent.logo_url %}
  <img class="agent-footer-logo" src="{{ agent.logo_url }}" alt="Company Logo">
  {% endif %}
</div>
{% endmacro %}


{# ── Page Footer ──────────────────────────────────────────────────────────── #}
{% macro page_footer() %}
<div class="page-footer">
  Report generated by TrendyReports &middot; Data source: MLS
</div>
{% endmacro %}


{# ── Monthly trend chart (§7.3) ─────────────────────────────────────────────
   Twelve monthly medians as one line. Inline SVG: this is rendered by
   PDFShift, so there is no script, no external request and no web font
   dependency inside the mark — everything the chart needs is in the document
   already.

   THE SPECS ARE NOT PREFERENCES. 2px line with round joins; end marker r>=4
   with a 2px surface ring; hairline SOLID gridlines one step off the surface
   (never dashed — dashing reads as "projection" when it is just a grid); area
   wash at 10%; labels on the endpoint and the extreme ONLY, never a number on
   every point.

   TEXT WEARS TEXT TOKENS, NOT THE SERIES COLOUR. The line carries identity;
   the value labels and axis ticks are grays. A brand hue light enough to be a
   cheerful line is illegible as 9px text.

   NO LEGEND. One series, so the heading above already names it; a box with one
   swatch restates the heading and costs page space, which on this surface is
   the scarcest thing there is.

   NO HOVER LAYER, and that is the one place this departs from how the same
   chart would be built for a screen. There is no pointer in a PDF. Nothing is
   gated behind one either: the axis ticks carry the scale, the two direct
   labels carry the values that matter, and `months_note` states the sample.

   A GAP IS A GAP. `value: none` means that month had fewer than three
   closings, so there is no median to draw. The path breaks rather than
   dropping to zero, because a zero would draw a crash that did not happen.
#}
{% macro monthly_trend_chart(points, ink, months_note=none, fmt='currency', width=680, height=150) %}
{%- set pad_l = 52 -%}
{%- set pad_r = 74 -%}
{%- set pad_t = 12 -%}
{%- set pad_b = 20 -%}
{%- set plot_w = width - pad_l - pad_r -%}
{%- set plot_h = height - pad_t - pad_b -%}
{# `selectattr('value')` would drop a real zero as well as a gap, which is
   exactly the distinction monthly_trend draws: a month with no closings is a
   zero in the count series and a GAP in the median one. Test for None. #}
{%- set drawn = points | rejectattr('value', 'none') | list -%}
{%- if drawn | length >= 2 -%}
{%- set vals = drawn | map(attribute='value') | list -%}
{%- set vmin = vals | min -%}
{%- set vmax = vals | max -%}
{%- set span = (vmax - vmin) if (vmax - vmin) > 0 else (vmax * 0.1 or 1) -%}
{# A flat series would otherwise divide by zero, and the 15% pad keeps the line
   off the gridlines at the extremes.

   A COUNT SERIES IS ANCHORED AT ZERO; A PRICE SERIES IS NOT. Seven sales
   against thirteen on a baseline of five reads as a collapse — the axis does
   the exaggerating, not the data. Zero is both meaningful and reachable for a
   count of homes sold, so the scale starts there and the swing is shown at its
   true size. A median price is never near zero, and anchoring it there would
   flatten every real movement into a straight line, so it keeps a fitted
   scale. Same chart, two honest answers, because the quantities differ. #}
{%- set lo = 0 if fmt != 'currency' else vmin - span * 0.15 -%}
{%- set hi = vmax + span * 0.15 -%}
{%- set n = points | length -%}
{%- set step = plot_w / (n - 1) if n > 1 else plot_w -%}
<div class="trend-chart avoid-break">
  <svg viewBox="0 0 {{ width }} {{ height }}" width="100%" height="{{ height }}"
       role="img" aria-label="Median closed price by month, last {{ n }} months"
       style="display:block; overflow:visible;">
    {% for f in [0.0, 0.5, 1.0] %}
    {%- set y = pad_t + plot_h * f -%}
    {%- set v = hi - (hi - lo) * f -%}
    <line x1="{{ pad_l }}" y1="{{ '%.1f' % y }}" x2="{{ pad_l + plot_w }}" y2="{{ '%.1f' % y }}"
          stroke="#e7e5e4" stroke-width="1" />
    <text x="{{ pad_l - 8 }}" y="{{ '%.1f' % (y + 3) }}" text-anchor="end"
          font-size="9" fill="#78716c"
          style="font-variant-numeric: tabular-nums;">{% if fmt == 'currency' %}{{ v | format_currency_short }}{% else %}{{ v | round | int | format_number }}{% endif %}</text>
    {% endfor %}

    {%- set ns = namespace(d='', started=false) -%}
    {%- for p in points -%}
      {%- set x = pad_l + step * loop.index0 -%}
      {%- if p.value is not none -%}
        {%- set y = pad_t + plot_h * (hi - p.value) / (hi - lo) -%}
        {%- set ns.d = ns.d ~ (' M' if not ns.started else ' L') ~ ('%.1f' % x) ~ ' ' ~ ('%.1f' % y) -%}
        {%- set ns.started = true -%}
      {%- else -%}
        {%- set ns.started = false -%}
      {%- endif -%}
    {%- endfor -%}
    <path d="{{ ns.d | trim }}" fill="none" stroke="{{ ink }}" stroke-width="2"
          stroke-linejoin="round" stroke-linecap="round" />

    {% for p in points %}
    {%- set x = pad_l + step * loop.index0 -%}
    <text x="{{ '%.1f' % x }}" y="{{ height - 6 }}" text-anchor="middle"
          font-size="9" fill="#78716c">{{ p.label }}</text>
    {% endfor %}

    {# Endpoint and extreme only. The endpoint is where the reader's eye lands;
       the extreme is the other number they will look for. Everything else is
       the axis's job. #}
    {%- set last = drawn | last -%}
    {%- set top = (drawn | sort(attribute='value') | last) -%}
    {% for p in points %}
      {%- if p.value is not none and (p is sameas last or (p is sameas top and top.value != last.value)) -%}
      {%- set x = pad_l + step * loop.index0 -%}
      {%- set y = pad_t + plot_h * (hi - p.value) / (hi - lo) -%}
      <circle cx="{{ '%.1f' % x }}" cy="{{ '%.1f' % y }}" r="4.5"
              fill="{{ ink }}" stroke="#ffffff" stroke-width="2" />
      {%- if p is sameas last -%}
      <text x="{{ '%.1f' % (x + 10) }}" y="{{ '%.1f' % (y + 4) }}" text-anchor="start"
            font-size="11" font-weight="600" fill="#292524"
            >{% if fmt == 'currency' %}{{ p.value | format_currency_short }}{% else %}{{ p.value | format_number }}{% endif %}</text>
      {%- else -%}
      <text x="{{ '%.1f' % x }}" y="{{ '%.1f' % (y - 10) }}" text-anchor="middle"
            font-size="10" font-weight="600" fill="#44403c"
            >{% if fmt == 'currency' %}{{ p.value | format_currency_short }}{% else %}{{ p.value | format_number }}{% endif %}</text>
      {%- endif -%}
      {%- endif -%}
    {% endfor %}
  </svg>
  {% if months_note %}
  <p class="trend-chart-note">{{ months_note }}</p>
  {% endif %}
</div>
{%- endif -%}
{% endmacro %}


{# ── Page-1 masthead (§7.1 variant A) ──────────────────────────────────────
   The full gradient masthead, as ORDINARY BODY CONTENT on page 1.

   It used to live in PDFShift's `header` slot and repeat at full size on every
   page. It cannot stay there and also be page-1-only: that needs
   header.start_at=2 with footer.start_at=1, and PDFShift silently coerces both
   to 2, taking the page-1 footer with it (D-103, measured). Moving it into the
   body sidesteps the negotiation entirely — the document flows, so this appears
   once, at the top, which is what "page 1 only" means in a flowing document.

   It also stops being a height negotiated with a vendor. In the header slot the
   reservation and the paint had to be kept in agreement by hand, and they were
   not: 1.3in reserved for 1.165in painted. Here it is as tall as its content.
#}
{% macro report_masthead(header, agent) %}
<div class="masthead avoid-break">
  <div class="masthead-left">
    {# §7.1 — one line, in a box whose height does not depend on this size.
       The size comes from MarketReportBuilder._masthead_title_px; see there for
       why a ladder and not a wrap. #}
    <h1 class="masthead-title" style="font-size: {{ header.title_px | default(24) }}px;">{{ header.title }}{% if header.city %} <span class="masthead-city">— {{ header.city }}</span>{% endif %}</h1>
    <p class="masthead-subtitle">
      Last <span class="masthead-highlight">{{ header.lookback_days }} days</span>
      {%- if header.subtitle %} · {{ header.subtitle }}{% endif %} · Live MLS Data
    </p>
    {# 0 is a result, not a missing field (D-108): the report shows the
       number it matched rather than dropping the block. #}
    {% if header.total_count is not none %}
    <div class="masthead-metric">
      <span class="masthead-metric-value">{{ header.total_count }}</span>
      <span class="masthead-metric-label">{{ header.title }}</span>
    </div>
    {% endif %}
  </div>
  <div class="masthead-right">
    {% if agent and agent.logo_url %}
    <img class="masthead-logo" src="{{ agent.logo_url }}" alt="">
    {% endif %}
  </div>
</div>
{% endmacro %}


{# ── Price-band distribution (§7.3) ────────────────────────────────────────
   Horizontal bars, one per band, counts.

   WHY BARS AND NOT A LINE. Price bands are ordered CATEGORIES, not a time
   series — the question is "which band is the market" rather than "which way
   is it going". And why a chart at all, next to stat cards that already carry
   the exact counts: the cards give four numbers and no shape. A reader can
   see 18, 31, 21, 11 and still not see that the middle band is the market.
   The bars carry the comparison; the cards keep the values. They complement
   rather than duplicate, which is also why there is no number on every bar.

   HORIZONTAL, because the labels are "$900K – $1.3M" and a vertical chart
   would rotate them or truncate them. Rotated axis labels are a readability
   cost paid for nothing here.

   §7.3's rule is "direct-label the endpoint and the largest bar, never every
   point". A bar chart has no endpoint, so the largest bar carries the only
   label — and it is the one the reader is looking for.

   Bars are `primary_ink`, the one brand value guaranteed as ink on white
   (themes.py), which this page's surface is. No axis line: with labels on the
   left and a single labelled value, a rule would be one more piece of
   furniture than the chart needs.
#}
{% macro band_distribution_chart(bands, ink, note=none, width=680) %}
{# A BAND WITH ZERO LISTINGS IS A REAL ZERO, not a gap. `selectattr('count')`
   was the first version and it silently dropped those bands — the identical
   mistake the trend chart makes one macro over, where a month with no closings
   is a gap and a month with no SALES is a zero. Here "nothing is for sale above
   $1.6M" is a fact about the market and one of the more useful things on the
   page; a band that simply vanishes tells the reader nothing and looks like a
   shorter list. Bands with no `count` KEY at all are a different thing — no
   data rather than no listings — and those are dropped. #}
{%- set rows = bands | rejectattr('count', 'undefined') | rejectattr('count', 'none') | list -%}
{%- if rows | length >= 2 -%}
{%- set bar_h = 18 -%}
{%- set gap = 10 -%}
{%- set pad_t = 4 -%}
{%- set label_w = 132 -%}
{%- set value_w = 52 -%}
{%- set plot_w = width - label_w - value_w -%}
{%- set height = pad_t * 2 + (rows | length) * bar_h + ((rows | length) - 1) * gap -%}
{%- set counts = rows | map(attribute='count') | list -%}
{%- set vmax = counts | max -%}
{%- set top = (rows | sort(attribute='count') | last) -%}
<div class="band-chart avoid-break">
  <svg viewBox="0 0 {{ width }} {{ height }}" width="100%" height="{{ height }}"
       role="img" aria-label="Active listings by price band"
       style="display:block; overflow:visible;">
    {% for band in rows %}
    {%- set y = pad_t + loop.index0 * (bar_h + gap) -%}
    {%- set w = (plot_w * band.count / vmax) if vmax else 0 -%}
    <text x="{{ label_w - 12 }}" y="{{ y + bar_h - 5 }}" text-anchor="end"
          font-size="11" fill="#44403c">{{ band.label }}</text>
    {# 4px rounded at the data end, square at the baseline: one rect plus a
       rounded overlay is fragile at small widths, so the whole bar is rounded
       and the baseline is covered by a square cap. #}
    {% if band.count %}
    <rect x="{{ label_w }}" y="{{ y }}" width="{{ '%.1f' % w }}" height="{{ bar_h }}"
          rx="4" fill="{{ ink }}" />
    <rect x="{{ label_w }}" y="{{ y }}" width="4" height="{{ bar_h }}" fill="{{ ink }}" />
    {% else %}
    {# Zero listings. A 0-width rect draws nothing and reads as a missing row,
       so the band says so in words at the baseline. #}
    <text x="{{ label_w + 4 }}" y="{{ y + bar_h - 5 }}" text-anchor="start"
          font-size="10" fill="#78716c">none</text>
    {% endif %}
    {% if band is sameas top %}
    <text x="{{ '%.1f' % (label_w + w + 8) }}" y="{{ y + bar_h - 5 }}" text-anchor="start"
          font-size="11" font-weight="600" fill="#292524">{{ band.count | format_number }}</text>
    {% endif %}
    {% endfor %}
  </svg>
  {% if note %}
  <p class="band-chart-note">{{ note }}</p>
  {% endif %}
</div>
{%- endif -%}
{% endmacro %}
